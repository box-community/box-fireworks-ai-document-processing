# Copy this file to .env and replace every required placeholder.
# Keep .env local; the server never sends these values to the browser.

# Box Client Credentials Grant service account
BOX_CLIENT_ID=replace_with_box_client_id
BOX_CLIENT_SECRET=replace_with_box_client_secret
BOX_ENTERPRISE_ID=replace_with_box_enterprise_id

# Optional default source shown only as configured, never exposed to the browser
BOX_SHARED_LINK=

# Fireworks
FIREWORKS_API_KEY=replace_with_fireworks_api_key
FIREWORKS_ACCOUNT_ID=replace_with_fireworks_account_id

# Optional; leave unset to use the pipeline default
# SPACY_MODEL=replace_with_installed_spacy_model
